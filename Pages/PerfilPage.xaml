<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BogoMaps.Pages.PerfilPage"
             Title="Perfil"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">

            <!-- Cabecera de perfil -->
            <Border Style="{StaticResource BogoCard}" Padding="24">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Border BackgroundColor="{StaticResource PrimaryFixed}" StrokeThickness="0"
                            WidthRequest="88" HeightRequest="88" HorizontalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="44" /></Border.StrokeShape>
                        <Label Text="VR" FontSize="28" TextColor="{StaticResource BrandPrimaryDark}"
                               FontFamily="{StaticResource FontBold}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Valentina Ríos ?" Style="{StaticResource BogoH2}" HorizontalOptions="Center" />
                    <Label Text="@valentina_camina · Teusaquillo, Bogotá D.C." Style="{StaticResource BogoBodySm}" HorizontalOptions="Center" />
                    <Label Text="Recorriendo Bogotá a pie. Enfocada en pasos seguros para personas mayores y andenes despejados."
                           Style="{StaticResource BogoBodySm}" HorizontalTextAlignment="Center" />
                    <Button Text="Editar perfil" Style="{StaticResource BogoSecondaryButton}" Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Impacto -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Impacto Ciudadano" Style="{StaticResource BogoH2}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border Style="{StaticResource BogoCard}">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="28" Style="{StaticResource BogoH1}" HorizontalOptions="Center" />
                            <Label Text="Reportes creados" Style="{StaticResource BogoBodySm}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource BogoCard}">
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="342" Style="{StaticResource BogoH1}" HorizontalOptions="Center" />
                            <Label Text="Peatones guiados" Style="{StaticResource BogoBodySm}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- Pestañas -->
            <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" Padding="4">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                    <Button x:Name="TabActivos" Text="Activos (12)" FontSize="12" CornerRadius="12"
                            BackgroundColor="{StaticResource SurfaceLowest}" TextColor="{StaticResource OnSurface}"
                            Clicked="OnTabClicked" />
                    <Button Grid.Column="1" x:Name="TabResueltos" Text="Resueltos (16)" FontSize="12" CornerRadius="12"
                            BackgroundColor="Transparent" TextColor="{StaticResource OnSurfaceVariant}"
                            Clicked="OnTabClicked" />
                    <Button Grid.Column="2" x:Name="TabGuardados" Text="Guardados (5)" FontSize="12" CornerRadius="12"
                            BackgroundColor="Transparent" TextColor="{StaticResource OnSurfaceVariant}"
                            Clicked="OnTabClicked" />
                </Grid>
            </Border>

            <!-- Reportes -->
            <VerticalStackLayout Spacing="10">
                <Border Style="{StaticResource BogoCard}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Falta de luz en Calle 45 con Cra 19" Style="{StaticResource BogoLabel}" FontSize="14" />
                        <Label Text="Barrio Palermo · Hace 1 día · Alumbrado" Style="{StaticResource BogoBodySm}" />
                        <Label Text="&#x23F3; En validación por 8 peatones" FontSize="11"
                               TextColor="{StaticResource OnTertiaryFixed}" FontFamily="{StaticResource FontBold}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource BogoCard}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Rampa reparada en Cra 11 con 82" Style="{StaticResource BogoLabel}" FontSize="14" />
                        <Label Text="Zona Rosa · Hace 3 días · Accesibilidad" Style="{StaticResource BogoBodySm}" />
                        <Label Text="&#x2705; Verificado por la comunidad (24 votos)" FontSize="11"
                               TextColor="{StaticResource OnSecondaryContainer}" FontFamily="{StaticResource FontBold}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource BogoCard}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Hueco profundo en andén Calle 63" Style="{StaticResource BogoLabel}" FontSize="14" />
                        <Label Text="Chapinero Central · Hace 1 semana · Infraestructura" Style="{StaticResource BogoBodySm}" />
                        <Label Text="&#x1F3DB; Resuelto por IDU / Alcaldía Mayor" FontSize="11"
                               TextColor="{StaticResource BrandPrimaryDark}" FontFamily="{StaticResource FontBold}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Ajustes -->
            <VerticalStackLayout Spacing="10">
                <Border Style="{StaticResource BogoCard}" Padding="14">
                    <VerticalStackLayout>
                        <Label Text="Configuración de cuenta" Style="{StaticResource BogoLabel}" FontSize="14" />
                        <Label Text="Notificaciones, privacidad y geolocalización" Style="{StaticResource BogoBodySm}" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Cerrar sesión" Style="{StaticResource BogoDangerButton}" Clicked="OnCerrarSesionClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
