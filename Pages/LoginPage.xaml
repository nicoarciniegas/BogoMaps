<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BogoMaps.Pages.LoginPage"
             Title="Iniciar sesi&#xF3;n"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16,40,16,24" Spacing="20">

            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Border BackgroundColor="{StaticResource BrandPrimary}" StrokeThickness="0"
                        WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Label Text="B" FontSize="40" TextColor="White" FontFamily="{StaticResource FontExtraBold}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Border BackgroundColor="{StaticResource SurfaceHigh}" StrokeThickness="0"
                        Padding="10,2" HorizontalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="999" /></Border.StrokeShape>
                    <Label Text="COMUNIDAD CAMINANTE" FontSize="11" TextColor="{StaticResource BrandPrimaryDark}"
                           FontFamily="{StaticResource FontLabel}" />
                </Border>
                <Label Text="Bienvenido a BogoMaps" Style="{StaticResource BogoH1}" HorizontalOptions="Center" />
                <Label Text="Inicia sesi&#xF3;n para reportar el estado de las v&#xED;as, guardar tus rutas peatonales favoritas y cuidar a la comunidad caminante de Bogot&#xE1;."
                       Style="{StaticResource BogoBodySm}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource BogoCard}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Correo electr&#xF3;nico o celular" Style="{StaticResource BogoLabel}" />
                        <Border BackgroundColor="{StaticResource SurfaceLow}" StrokeThickness="0" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Entry x:Name="UsuarioEntry" Placeholder="ejemplo@correo.com" Keyboard="Email"
                                   TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}"
                                   FontFamily="{StaticResource FontRegular}" HeightRequest="48" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Contrase&#xF1;a" Style="{StaticResource BogoLabel}" />
                            <Label Grid.Column="1" Text="&#xBF;Olvidaste tu contrase&#xF1;a?" FontSize="11"
                                   TextColor="{StaticResource BrandPrimary}" FontFamily="{StaticResource FontLabel}" />
                        </Grid>
                        <Border BackgroundColor="{StaticResource SurfaceLow}" StrokeThickness="0" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="ClaveEntry" Placeholder="********" IsPassword="True"
                                       TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}"
                                       FontFamily="{StaticResource FontRegular}" HeightRequest="48" />
                                <Button Grid.Column="1" x:Name="MostrarClaveButton" Text="Ver" FontSize="12"
                                        BackgroundColor="Transparent" TextColor="{StaticResource Outline}"
                                        Clicked="OnToggleClave" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Iniciar sesi&#xF3;n" Style="{StaticResource BogoPrimaryButton}" Clicked="OnLoginClicked" />

                    <Label Text="o contin&#xFA;a con" Style="{StaticResource BogoBodySm}" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Google" Style="{StaticResource BogoSecondaryButton}" HeightRequest="48" />
                        <Button Grid.Column="1" Text="Apple" Style="{StaticResource BogoSecondaryButton}" HeightRequest="48" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource SurfaceHigh}" StrokeThickness="0" Padding="14">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInvitadoTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Explorar como peat&#xF3;n invitado" Style="{StaticResource BogoLabel}" FontSize="13" />
                        <Label Text="Consulta el mapa sin iniciar sesi&#xF3;n" Style="{StaticResource BogoBodySm}" FontSize="11" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="&#x203A;" FontSize="22" TextColor="{StaticResource Outline}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="&#xBF;No tienes una cuenta?" Style="{StaticResource BogoBodySm}" />
                <Label Text="Reg&#xED;strate gratis" FontSize="13" TextColor="{StaticResource BrandPrimary}"
                       FontFamily="{StaticResource FontBold}" />
            </HorizontalStackLayout>

            <Label Text="Tus datos colaborativos impulsan una movilidad peatonal m&#xE1;s segura en Bogot&#xE1;."
                   Style="{StaticResource BogoBodySm}" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
