<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BogoMaps.Pages.ReportarPage"
             Title="Reportar"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="20">

            <VerticalStackLayout Spacing="4">
                <Border BackgroundColor="{StaticResource SurfaceHigh}" StrokeThickness="0"
                        Padding="10,4" HorizontalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="999" />
                    </Border.StrokeShape>
                    <Label Text="REPORTE COLABORATIVO" FontSize="11"
                           TextColor="{StaticResource BrandPrimaryDark}"
                           FontFamily="{StaticResource FontBold}" />
                </Border>
                <Label Text="Nuevo Reporte Peatonal" Style="{StaticResource BogoH1}" />
                <Label Text="Ayuda a otros peatones en Bogotá compartiendo el estado real de las aceras y cruces de la ciudad."
                       Style="{StaticResource BogoBodySm}" />
            </VerticalStackLayout>

            <!-- Ubicación -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Ubicación del incidente" Style="{StaticResource BogoLabel}" FontSize="14" />
                <Border Style="{StaticResource BogoCard}" Padding="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Lugar seleccionado" FontSize="11" Style="{StaticResource BogoBodySm}" />
                            <Label x:Name="UbicacionLabel" Text="Cra 13 con Calle 53, Bogotá" Style="{StaticResource BogoLabel}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Button Text="Usar mi ubicación GPS actual"
                        Style="{StaticResource BogoSecondaryButton}"
                        TextColor="{StaticResource BrandPrimary}"
                        Clicked="OnGpsClicked" />
            </VerticalStackLayout>

            <!-- Categoría -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Tipo de incidencia" Style="{StaticResource BogoLabel}" FontSize="14" />
                    <Label Grid.Column="1" Text="Selecciona una opción" FontSize="11" Style="{StaticResource BogoBodySm}" />
                </Grid>
                <Grid x:Name="CategoriaGrid" ColumnDefinitions="*,*" RowDefinitions="96,96,96" ColumnSpacing="10" RowSpacing="10">
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource BogoCard}" Padding="12" BackgroundColor="{StaticResource BrandPrimary}">
                        <Label Text="&#x1F9F1; Acera rota / Obstáculo" Style="{StaticResource BogoLabel}" TextColor="White" VerticalOptions="End" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoriaTapped" /></Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource BogoCard}" Padding="12" BackgroundColor="{StaticResource SurfaceLow}">
                        <Label Text="&#x1F311; Falta de iluminación" Style="{StaticResource BogoLabel}" VerticalOptions="End" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoriaTapped" /></Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource BogoCard}" Padding="12" BackgroundColor="{StaticResource SurfaceLow}">
                        <Label Text="&#x267F; Rampa bloqueada / Inaccesible" Style="{StaticResource BogoLabel}" VerticalOptions="End" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoriaTapped" /></Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource BogoCard}" Padding="12" BackgroundColor="{StaticResource SurfaceLow}">
                        <Label Text="&#x26A0; Cruce peatonal peligroso" Style="{StaticResource BogoLabel}" VerticalOptions="End" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoriaTapped" /></Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource BogoCard}" Padding="12" BackgroundColor="{StaticResource SurfaceLow}">
                        <Label Text="&#x1F6A7; Obra en vía peatonal" Style="{StaticResource BogoLabel}" VerticalOptions="End" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoriaTapped" /></Border.GestureRecognizers>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource BogoCard}" Padding="12" BackgroundColor="{StaticResource SurfaceLow}">
                        <Label Text="&#x2705; Punto seguro / Recomendado" Style="{StaticResource BogoLabel}" VerticalOptions="End" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoriaTapped" /></Border.GestureRecognizers>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- Gravedad -->
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Gravedad del obstáculo" Style="{StaticResource BogoLabel}" FontSize="14" />
                    <Label x:Name="GravedadLabel" Grid.Column="1" Text="Moderado" FontSize="11"
                           TextColor="{StaticResource TertiaryContainer}"
                           FontFamily="{StaticResource FontBold}" />
                </Grid>
                <Border BackgroundColor="{StaticResource SurfaceContainer}" StrokeThickness="0" Padding="4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Grid x:Name="GravedadGrid" ColumnDefinitions="*,*,*" ColumnSpacing="4">
                        <Button Grid.Column="0" x:Name="BtnBajo" Text="Bajo" FontSize="12" CornerRadius="8"
                                BackgroundColor="Transparent" TextColor="{StaticResource OnSurfaceVariant}"
                                Clicked="OnGravedadClicked" />
                        <Button Grid.Column="1" x:Name="BtnModerado" Text="Moderado" FontSize="12" CornerRadius="8"
                                BackgroundColor="{StaticResource TertiaryFixed}" TextColor="{StaticResource OnTertiaryFixed}"
                                Clicked="OnGravedadClicked" />
                        <Button Grid.Column="2" x:Name="BtnCritico" Text="Crítico" FontSize="12" CornerRadius="8"
                                BackgroundColor="Transparent" TextColor="{StaticResource OnSurfaceVariant}"
                                Clicked="OnGravedadClicked" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Evidencia -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Evidencia visual" Style="{StaticResource BogoLabel}" FontSize="14" />
                <Button Text="&#x1F4F7; Tomar foto" Style="{StaticResource BogoSecondaryButton}"
                        TextColor="{StaticResource BrandPrimary}" Clicked="OnFotoClicked" />
            </VerticalStackLayout>

            <!-- Descripción -->
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Detalles adicionales" Style="{StaticResource BogoLabel}" FontSize="14" />
                    <Label Grid.Column="1" Text="Máx. 250 caract." FontSize="11" Style="{StaticResource BogoBodySm}" />
                </Grid>
                <Border Style="{StaticResource BogoCard}" Padding="8">
                    <Editor x:Name="DescripcionEditor"
                            HeightRequest="90"
                            MaxLength="250"
                            Placeholder="Describe detalles que ayuden a otros peatones..."
                            PlaceholderColor="{StaticResource Outline}"
                            TextColor="{StaticResource OnSurface}"
                            FontSize="14" />
                </Border>
            </VerticalStackLayout>

            <!-- Anónimo -->
            <Border Style="{StaticResource BogoCard}" Padding="12">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Publicar en modo anónimo" Style="{StaticResource BogoLabel}" FontSize="13" />
                        <Label Text="Oculta tu usuario en el mapa público" FontSize="11" Style="{StaticResource BogoBodySm}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" x:Name="AnonimoSwitch" OnColor="{StaticResource BrandPrimary}" />
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="6">
                <Button x:Name="PublicarBtn" Text="Publicar Reporte en el Mapa"
                        Style="{StaticResource BogoPrimaryButton}" Clicked="OnPublicarClicked" />
                <Label Text="Al reportar, aportas a los datos abiertos del Sistema Peatonal Distrital."
                       FontSize="11" HorizontalTextAlignment="Center" Style="{StaticResource BogoBodySm}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
